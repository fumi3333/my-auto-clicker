<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SmartTap (自動タップ学習)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_overlay_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. 他のアプリの上に重ねて表示を許可"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_accessibility_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. ユーザー補助サービスをONにする"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_start_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="コントローラーを画面に起動"
        android:backgroundTint="#007ACC"
        android:textColor="#FFFFFF" />

</LinearLayout>
